# Pick the audio calibration like the stock AGM does, it is
# loaded from the ravelin_qrd directory.
on init
    mount none /vendor/etc/acdbdata/ravelin_qrd_cust /vendor/etc/acdbdata/ravelin_qrd bind

on property:ro.boot.hwc=India
    mount none /vendor/etc/acdbdata/ravelin_qrd_cust_in /vendor/etc/acdbdata/ravelin_qrd bind

on property:ro.boot.hwc=JP
    mount none /vendor/etc/acdbdata/ravelin_qrd_cust_jp /vendor/etc/acdbdata/ravelin_qrd bind

on boot
    # Fingerprint
    chown system system /dev/goodix_fp
    chmod 0660 /dev/goodix_fp
    chown system system /sys/bus/platform/devices/soc:fpc1020/compatible_all
    chown system system /sys/bus/platform/devices/soc:fpc1020/device_prepare
    chown system system /sys/bus/platform/devices/soc:fpc1020/fingerdown_wait
    chown system system /sys/bus/platform/devices/soc:fpc1020/hw_reset
    chown system system /sys/bus/platform/devices/soc:fpc1020/irq
    chown system system /sys/bus/platform/devices/soc:fpc1020/power_ctrl
    chown system system /sys/bus/platform/devices/soc:fpc1020/regulator_enable
    chown system system /sys/bus/platform/devices/soc:fpc1020/screen
    chown system system /sys/bus/platform/devices/soc:fpc1020/wakeup_enable
    chmod 0660 /sys/bus/platform/devices/soc:fpc1020/compatible_all
    chmod 0660 /sys/bus/platform/devices/soc:fpc1020/device_prepare
    chmod 0660 /sys/bus/platform/devices/soc:fpc1020/fingerdown_wait
    chmod 0660 /sys/bus/platform/devices/soc:fpc1020/hw_reset
    chmod 0660 /sys/bus/platform/devices/soc:fpc1020/irq
    chmod 0660 /sys/bus/platform/devices/soc:fpc1020/power_ctrl
    chmod 0660 /sys/bus/platform/devices/soc:fpc1020/regulator_enable
    chmod 0660 /sys/bus/platform/devices/soc:fpc1020/screen
    chmod 0660 /sys/bus/platform/devices/soc:fpc1020/wakeup_enable

    # Touchscreen
    chown system system /proc/touchscreen/proximity_switch
    chown system system /proc/touchscreen/store_data_proximity
    chown system system /sys/class/touch/touch_dev/palm_sensor
    chmod 0664 /proc/touchscreen/proximity_switch
    chmod 0664 /proc/touchscreen/store_data_proximity
    chmod 0664 /sys/class/touch/touch_dev/palm_sensor

on post-fs-data
    mkdir /data/vendor/fpc 0770 system system
    mkdir /data/vendor/goodix 0770 system system
